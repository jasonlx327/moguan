{
  "name": "moguan-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "kb:validate": "node scripts/validate-knowledge-base.mjs",
    "kb:search": "node scripts/search-knowledge-base.mjs",
    "forecasts:validate": "node scripts/validate-forecast-ledger.mjs forecast-ledger/forecasts/2026-07-23.json",
    "validations:validate": "node scripts/validate-current-validations.mjs",
    "review:daily": "node scripts/create-daily-review.mjs",
    "reviews:validate": "node scripts/validate-daily-reviews.mjs",
    "daily:cycle": "node scripts/run-daily-cycle.mjs",
    "hormuz:fetch": "node scripts/fetch-hormuz-portwatch.mjs",
    "hormuz:update": "node scripts/fetch-hormuz-portwatch.mjs --output transit-monitor/current.json",
    "hormuz:verify": "node scripts/update-hormuz-validation.mjs --output forecast-ledger/validations/FORECAST-2026-07-23-04.current.json",
    "hormuz:daily": "npm run hormuz:update && npm run hormuz:verify",
    "stars:fetch": "node scripts/fetch-bright-stars.mjs",
    "weather:fetch": "node scripts/fetch-weather-snapshot.mjs",
    "weather:validate": "node scripts/validate-weather-snapshot.mjs",
    "federal-register:fetch": "node scripts/fetch-federal-register.mjs --output guanxiang/federal-register/current.json",
    "federal-register:validate": "node scripts/validate-federal-register-snapshot.mjs guanxiang/federal-register/current.json",
    "eu-cellar:fetch": "node scripts/fetch-eu-cellar.mjs --output guanxiang/eu-cellar/current.json",
    "eu-cellar:validate": "node scripts/validate-eu-cellar-snapshot.mjs guanxiang/eu-cellar/current.json",
    "cn-policy:fetch": "node scripts/fetch-cn-gov-policy.mjs --output guanxiang/cn-gov-policy/current.json",
    "cn-policy:validate": "node scripts/validate-cn-gov-policy-snapshot.mjs guanxiang/cn-gov-policy/current.json",
    "cn-policy:remote-probe": "node scripts/run-cn-policy-remote.mjs --output artifacts/cn-policy-current.json",
    "events:validate": "node scripts/validate-event-ledger.mjs event-ledger/daily/2026-07-23.json",
    "events:validate:publish": "node scripts/validate-event-ledger.mjs event-ledger/daily/2026-07-23.json --publish",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
